#include <u32std.h>

extern "C" {

extern TInt _E32Dll_Body(TInt);

__NAKED__ TInt _E32Dll(TInt /*aReason*/)
	{
	EKA2_ENTRY_POINT_VERSION_IDENTIFIER;	// DUMMY INSTRUCTION TO INDICATE EKA2 ENTRY POINT
	asm("ldr r12, 1f ");
	__JUMP(,r12);

	asm(".word 0 ");			// loader will replace with code seg unique ID
								// for RAM-loaded code segment
								// MUST BE AT OFFSET 12 FROM ENTRY POINT

	asm("1: ");
	asm(".word _E32Dll_Body ");
	}

#if defined(__GCC32__) && (defined(__EABI__) || defined(__ARM_EABI__))
__NAKED__ void __call_init_array()
	{
	asm(".weak SHT$$INIT_ARRAY$$Base ");
	asm(".weak SHT$$INIT_ARRAY$$Limit ");
	asm("push {r4, r5, r6, lr} ");
	asm("ldr r4, =SHT$$INIT_ARRAY$$Base ");
	asm("ldr r5, =SHT$$INIT_ARRAY$$Limit ");
	asm("cmp r4, #0 ");
	asm("beq 2f ");
	asm("cmp r5, #0 ");
	asm("beq 2f ");
	asm("1: ");
	asm("cmp r4, r5 ");
	asm("bhs 2f ");
	asm("ldr r0, [r4] ");
	asm("add r0, r0, r4 ");
	asm("add r4, r4, #4 ");
	asm("blx r0 ");
	asm("b 1b ");
	asm("2: ");
	asm("pop {r4, r5, r6, pc} ");
	}
#endif
}

