#if defined(VFPHELPERS) && !defined(NOVFPHELPERS)
#   define FP_EXT _vfpv2.dll
#else
#   define FP_EXT .dll
#endif

file=\Epoc32\Release\##MAIN##\##BUILD##\scppnwdl.dll               \sys\bin\scppnwdl.dll

file=\Epoc32\Release\##MAIN##\##BUILD##\drtaeabi.dll               \sys\bin\drtaeabi.dll
file=\Epoc32\Release\##MAIN##\##BUILD##\dfpaeabi##FP_EXT           \sys\bin\dfpaeabi.dll

// Support for old binaries.
file=\Epoc32\Release\##MAIN##\##BUILD##\dfprvct-thunk.dll			\sys\bin\dfprvct-thunk.dll
alias \sys\bin\dfprvct-thunk.dll					\sys\bin\dfprvct2_2-thunk.dll
alias \sys\bin\dfprvct-thunk.dll					\sys\bin\dfprvct2_1-thunk.dll

#if defined(RVCT2_2)
    file=\Epoc32\Release\##MAIN##\##BUILD##\drtrvct2_2##FP_EXT     \sys\bin\drtrvct2_2.dll
    file=\Epoc32\Release\##MAIN##\##BUILD##\dfprvct2_2##FP_EXT     \sys\bin\dfprvct2_2.dll
    
    // Support for old binaries.
    alias \sys\bin\drtrvct2_2.dll                   \sys\bin\drtrvct2_1.dll
    alias \sys\bin\dfprvct2_2.dll                   \sys\bin\dfprvct2_1.dll
#elif defined(RVCT3_1) || defined(RVCT4_0)
    file=\Epoc32\Release\##MAIN##\##BUILD##\drtrvct3_1##FP_EXT     \sys\bin\drtrvct3_1.dll
    file=\Epoc32\Release\##MAIN##\##BUILD##\dfprvct3_1##FP_EXT     \sys\bin\dfprvct3_1.dll
    
    // Support for old binaries.
    alias \sys\bin\drtrvct3_1.dll                   \sys\bin\drtrvct2_2.dll
    alias \sys\bin\dfprvct3_1.dll                   \sys\bin\dfprvct2_2.dll
    alias \sys\bin\drtrvct3_1.dll                   \sys\bin\drtrvct2_1.dll
    alias \sys\bin\dfprvct3_1.dll                   \sys\bin\dfprvct2_1.dll
#endif

